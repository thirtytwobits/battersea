      ],
      "type": "object"
    },
    "FlowAutomationPortDefinition": {
      "additionalProperties": false,
      "description": "A typed sink port that delivers a token's value into one of the host\nnode's `parameter_values` *after* the upstream node activates. Unlike an\ninput port, an automation write does not drive activation; it is a\npost-activation side-channel write that downstream activations and UI\nbindings observe via the next flow-document broadcast.",
      "properties": {
        "accepted_token_types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "display_class": {
          "$ref": "#/$defs/FlowPortDisplayClass"
        },
        "long_description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameter_name": {
          "description": "The host-node parameter that this port writes to on token delivery.",
          "type": "string"
        },
        "short_description": {
          "type": "string"
        },
        "token_type": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "parameter_name",
        "token_type"
      ],
      "type": "object"
    },
    "FlowControllerActionDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
