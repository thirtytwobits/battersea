{
  "$defs": {
    "FlowActionPortDefinition": {
      "additionalProperties": false,
      "properties": {
        "display_class": {
          "$ref": "#/$defs/FlowPortDisplayClass"
        },
        "long_description": {
          "type": "string"
        },
