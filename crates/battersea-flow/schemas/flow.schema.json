        "kind"
      ],
      "type": "object"
    },
    "FlowDocument": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowEdge"
          },
          "type": "array"
        },
        "execution": {
          "$ref": "#/$defs/FlowExecutionPolicy"
        },
        "flow_key": {
          "type": "string"
        },
        "layout": {
          "additionalProperties": true,
          "description": "Opaque per-client canvas state, keyed by writer namespace.\nEach client controls its own namespace.",
          "type": "object"
        },
        "metadata": true,
        "nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowNode"
          },
          "type": "array"
        },
        "output_encoding": {
          "default": "xml",
          "description": "Flow-wide rendering encoding for nodes whose `output_encoding`\nparameter is set to `\"inherit\"` (the per-node default). One of\n`\"markdown\"`, `\"xml\"`, or `\"plain\"`. Missing values (legacy flows\nauthored before this field existed) fall back to `\"xml\"` via\n[`default_flow_output_encoding`], matching the substrate's\nhistorical default.",
          "type": "string"
        },
        "plain_fragment_delimiter": {
          "default": "blank_line",
          "description": "Flow-wide field delimiter used when a node emits the `plain`\nencoding and that encoding came from inheriting the flow's choice.\nCatalog enum token: `comma`, `blank_line`, `newline`, `space`, or\n`none`. Defaults to `blank_line` for legacy flows.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "whitespace_mode": {
          "default": "trim",
          "description": "Flow-wide whitespace handling for nodes whose `whitespace_mode`\nparameter is set to `\"inherit\"` (the per-node default). One of\n`\"trim\"`, `\"preserve\"`, or `\"compact\"`. Missing values (legacy flows\nauthored before this field existed) fall back to `\"trim\"` via\n[`default_flow_whitespace_mode`], matching Concatenate's historical\ndefault.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "execution",
        "flow_key",
        "title",
        "output_encoding",
        "plain_fragment_delimiter",
        "whitespace_mode",
        "nodes",
        "edges"
      ],
      "type": "object"
    },
