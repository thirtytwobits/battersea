      "enum": [
        "backpressure",
        "drop_oldest"
      ],
      "type": "string"
    },
    "FlowSignalPortDefinition": {
      "additionalProperties": false,
      "properties": {
        "display_class": {
          "$ref": "#/$defs/FlowPortDisplayClass"
        },
        "long_description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "short_description": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "FlowValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "FlowValidationResult": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowValidationIssue"
          },
          "type": "array"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "issues"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
