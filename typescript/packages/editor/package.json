{
  "name": "@battersea/editor",
  "version": "0.9.0",
  "description": "Unstyled flow editor and reusable graph primitives",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./graph/layout/*": {
      "types": "./dist/graph/layout/*.d.ts",
      "import": "./dist/graph/layout/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "stories",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@battersea/flow": "0.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@xyflow/react": "^12.8.5",
    "@dnd-kit/core": "^6.3.1",
    "react-amnesia": "^0.2.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "d3-force": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirtytwobits/battersea.git",
    "directory": "typescript/packages/editor"
  }
}
