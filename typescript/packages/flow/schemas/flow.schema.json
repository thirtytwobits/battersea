{
  "$defs": {
    "Cause": {
      "description": "What a failure wraps.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "failure": {
              "$ref": "#/$defs/Failure"
            }
          },
          "required": [
            "failure"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The text of an error of another type, then of each of its sources in order.",
          "properties": {
            "foreign": {
              "$ref": "#/$defs/Detail3"
            }
          },
          "required": [
            "foreign"
          ],
          "type": "object"
        }
      ]
    },
    "Detail": {
      "description": "A part of a failure that the host may withhold from a flow.",
      "oneOf": [
        {
          "description": "The reporter supplied nothing.",
          "properties": {
            "state": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "present",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The reporter supplied a value and the host's disclosure removed it.",
          "properties": {
            "state": {
              "const": "withheld",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Detail2": {
      "description": "A part of a failure that the host may withhold from a flow.",
      "oneOf": [
        {
          "description": "The reporter supplied nothing.",
          "properties": {
            "state": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "present",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PartialOutput"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The reporter supplied a value and the host's disclosure removed it.",
          "properties": {
            "state": {
              "const": "withheld",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Detail3": {
      "description": "A part of a failure that the host may withhold from a flow.",
      "oneOf": [
        {
          "description": "The reporter supplied nothing.",
          "properties": {
            "state": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "present",
              "type": "string"
            },
            "value": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The reporter supplied a value and the host's disclosure removed it.",
          "properties": {
            "state": {
              "const": "withheld",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "DispatchState": {
      "description": "What is known about the remote effect, independently of the failure category.",
      "enum": [
        "not_sent",
        "rejected",
        "accepted",
        "unknown"
      ],
      "type": "string"
    },
    "Exchange": {
      "description": "What is known of the remote exchange a failure belongs to.",
      "properties": {
        "attempts": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dispatch": {
          "$ref": "#/$defs/DispatchState",
          "default": "unknown"
        },
        "request_id": {
          "description": "The identifier the provider issued for the request.",
          "type": [
            "string",
            "null"
          ]
        },
        "response_id": {
          "description": "The identifier the provider issued for the response.",
          "type": [
            "string",
            "null"
          ]
        },
        "retry_after_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "dispatch",
        "attempts"
      ],
      "type": "object"
    },
    "Failure": {
      "$ref": "#/$defs/FailureParts",
      "description": "One failed or incomplete operation. The parts are boxed so a `Result` that carries a\nfailure stays small."
    },
    "FailureParts": {
      "description": "The parts of a [`Failure`].",
      "properties": {
        "cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cause"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ],
          "description": "The failure of the cleanup Battersea attempted after the operation failed."
        },
        "context": {
          "additionalProperties": true,
          "description": "The values Battersea names in its description. A flow receives the context under\neither disclosure, so it holds no text a reporter wrote.",
          "type": "object"
        },
        "exchange": {
          "$ref": "#/$defs/Exchange",
          "default": {
            "attempts": 0,
            "dispatch": "unknown"
          }
        },
        "kind": {
          "type": "string"
        },
        "message": {
          "description": "Battersea's description, in fixed wording.",
          "type": "string"
        },
        "native": {
          "$ref": "#/$defs/Detail",
          "description": "The reporter's own account, whole."
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "default": {}
        },
        "partial": {
          "$ref": "#/$defs/Detail2"
        },
        "reporter": {
          "$ref": "#/$defs/Reporter",
          "default": "battersea"
        },
        "tool_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallEvidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Evidence about a nested tool call, independent from provider dispatch."
        },
        "tool_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tool runner's name for this refusal; `kind` is its class."
        },
        "watchdog": {
          "anyOf": [
            {
              "$ref": "#/$defs/WatchdogFailure"
            },
            {
              "type": "null"
            }
          ],
          "description": "The limit an idle watchdog enforced."
        }
      },
      "required": [
        "kind",
        "message",
        "reporter",
        "origin",
        "exchange"
      ],
      "type": "object"
    },
    "FlowActionPortDefinition": {
      "additionalProperties": false,
      "properties": {
        "display_class": {
          "$ref": "#/$defs/FlowPortDisplayClass"
        },
        "long_description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "short_description": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "FlowAutomationPortDefinition": {
      "additionalProperties": false,
      "description": "A typed sink port that delivers a token's value into one of the host\nnode's `parameter_values` *after* the upstream node activates. Unlike an\ninput port, an automation write does not drive activation; it is a\npost-activation side-channel write that downstream activations and UI\nbindings observe via the next flow-document broadcast.",
      "properties": {
        "accepted_token_types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "display_class": {
          "$ref": "#/$defs/FlowPortDisplayClass"
        },
        "long_description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameter_name": {
          "description": "The host-node parameter that this port writes to on token delivery.",
          "type": "string"
        },
        "short_description": {
          "type": "string"
        },
        "token_type": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "parameter_name",
        "token_type"
      ],
      "type": "object"
    },
    "FlowControllerActionDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "long_description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "short_description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "FlowControllerOutputDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "long_description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "short_description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "FlowDocument": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowEdge"
          },
          "type": "array"
        },
        "execution": {
          "$ref": "#/$defs/FlowExecutionPolicy"
        },
        "flow_key": {
          "type": "string"
        },
        "layout": {
          "additionalProperties": true,
          "description": "Opaque per-client canvas state, keyed by writer namespace.\nEach client controls its own namespace.",
          "type": "object"
        },
        "metadata": true,
        "nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowNode"
          },
          "type": "array"
        },
        "output_encoding": {
          "default": "xml",
          "description": "Flow-wide rendering encoding for nodes whose `output_encoding`\nparameter is set to `\"inherit\"` (the per-node default). One of\n`\"markdown\"`, `\"xml\"`, or `\"plain\"`. Missing values (legacy flows\nauthored before this field existed) fall back to `\"xml\"` via\n[`default_flow_output_encoding`], matching the substrate's\nhistorical default.",
          "type": "string"
        },
        "plain_fragment_delimiter": {
          "default": "blank_line",
          "description": "Flow-wide field delimiter used when a node emits the `plain`\nencoding and that encoding came from inheriting the flow's choice.\nCatalog enum token: `comma`, `blank_line`, `newline`, `space`, or\n`none`. Defaults to `blank_line` for legacy flows.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "whitespace_mode": {
          "default": "trim",
          "description": "Flow-wide whitespace handling for nodes whose `whitespace_mode`\nparameter is set to `\"inherit\"` (the per-node default). One of\n`\"trim\"`, `\"preserve\"`, or `\"compact\"`. Missing values (legacy flows\nauthored before this field existed) fall back to `\"trim\"` via\n[`default_flow_whitespace_mode`], matching Concatenate's historical\ndefault.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "execution",
        "flow_key",
        "title",
        "output_encoding",
        "plain_fragment_delimiter",
        "whitespace_mode",
        "nodes",
        "edges"
      ],
      "type": "object"
    },
    "FlowDynamicPortGroup": {
      "additionalProperties": false,
      "properties": {
        "accepted_token_types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "count_parameter": {
          "type": "string"
        },
        "display_class": {
          "$ref": "#/$defs/FlowPortDisplayClass"
        },
        "long_description": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/FlowPortMode"
        },
        "name_template": {
          "type": "string"
        },
        "parameters": {
          "description": "Per-port parameter editors. Each port expanded from this group inherits\nthe same set of parameter declarations; values are stored per-port name\nunder `FlowNode::port_parameter_values.input[port_name]` (or\n`.output[port_name]` for dynamic output groups).",
          "items": {
            "$ref": "#/$defs/FlowParameterDefinition"
          },
          "type": "array"
        },
        "phase": {
          "$ref": "#/$defs/FlowPortPhase"
        },
        "short_description": {
          "type": "string"
        },
        "token_type": {
          "type": "string"
        }
      },
      "required": [
        "count_parameter",
        "name_template",
        "token_type",
        "mode",
        "phase"
      ],
      "type": "object"
    },
    "FlowDynamicSignalPortGroup": {
      "additionalProperties": false,
      "properties": {
        "count_parameter": {
          "type": "string"
        },
        "display_class": {
          "$ref": "#/$defs/FlowPortDisplayClass"
        },
        "long_description": {
          "type": "string"
        },
        "name_template": {
          "type": "string"
        },
        "short_description": {
          "type": "string"
        }
      },
      "required": [
        "count_parameter",
        "name_template"
      ],
      "type": "object"
    },
    "FlowEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FlowEdgeKind",
          "default": "token"
        },
        "order": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "queue": {
          "$ref": "#/$defs/FlowQueueLimits"
        },
        "source_node_id": {
          "type": "string"
        },
        "source_port": {
          "type": "string"
        },
        "target_node_id": {
          "type": "string"
        },
        "target_port": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "source_node_id",
        "source_port",
        "target_node_id",
        "target_port",
        "order"
      ],
      "type": "object"
    },
    "FlowEdgeKind": {
      "enum": [
        "token",
        "signal"
      ],
      "type": "string"
    },
    "FlowExecutionLimits": {
      "additionalProperties": false,
      "properties": {
        "node_retained_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pending_events": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "provider_queue": {
          "$ref": "#/$defs/FlowQueueLimits"
        },
        "retained_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pending_events",
        "retained_bytes",
        "node_retained_bytes",
        "provider_queue"
      ],
      "type": "object"
    },
    "FlowExecutionPolicy": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "$ref": "#/$defs/FlowExecutionLimits"
        },
        "source_order": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "source_order",
        "limits"
      ],
      "type": "object"
    },
    "FlowFailurePolicy": {
      "enum": [
        "fail",
        "emit",
        "skip"
      ],
      "type": "string"
    },
    "FlowFailurePort": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/FlowPortPhase"
        }
      },
      "required": [
        "name",
        "phase"
      ],
      "type": "object"
    },
    "FlowNode": {
      "additionalProperties": false,
      "properties": {
        "definition_name": {
          "type": "string"
        },
        "failure_policy": {
          "$ref": "#/$defs/FlowFailurePolicy"
        },
        "id": {
          "type": "string"
        },
        "instance_name": {
          "type": "string"
        },
        "parameter_values": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "port_names": {
          "$ref": "#/$defs/FlowNodePortNames"
        },
        "port_order": {
          "$ref": "#/$defs/FlowNodePortOrder"
        },
        "port_parameter_values": {
          "$ref": "#/$defs/FlowNodePortParameterValues"
        }
      },
      "required": [
        "id",
        "definition_name",
        "instance_name",
        "parameter_values"
      ],
      "type": "object"
    },
    "FlowNodeClass": {
      "enum": [
        "source",
        "control",
        "hybrid",
        "instrument",
        "inline",
        "logic",
        "sink"
      ],
      "type": "string"
    },
    "FlowNodeDefinition": {
      "additionalProperties": false,
      "properties": {
        "action_ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowActionPortDefinition"
          },
          "type": "array"
        },
        "activation_parameters": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "automation_ports": {
          "items": {
            "$ref": "#/$defs/FlowAutomationPortDefinition"
          },
          "type": "array"
        },
        "class_name": {
          "type": "string"
        },
        "controller_actions": {
          "items": {
            "$ref": "#/$defs/FlowControllerActionDefinition"
          },
          "type": "array"
        },
        "controller_outputs": {
          "items": {
            "$ref": "#/$defs/FlowControllerOutputDefinition"
          },
          "type": "array"
        },
        "dynamic_action_ports": {
          "items": {
            "$ref": "#/$defs/FlowDynamicSignalPortGroup"
          },
          "type": "array"
        },
        "dynamic_input_ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowDynamicPortGroup"
          },
          "type": "array"
        },
        "dynamic_output_ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowDynamicPortGroup"
          },
          "type": "array"
        },
        "dynamic_signal_ports": {
          "items": {
            "$ref": "#/$defs/FlowDynamicSignalPortGroup"
          },
          "type": "array"
        },
        "failure_ports": {
          "items": {
            "$ref": "#/$defs/FlowFailurePort"
          },
          "type": "array"
        },
        "handler_id": {
          "type": "string"
        },
        "input_ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowPort"
          },
          "type": "array"
        },
        "interfaces": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/FlowNodeClass"
        },
        "long_description": {
          "type": "string"
        },
        "output_ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowPort"
          },
          "type": "array"
        },
        "parameters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowParameterDefinition"
          },
          "type": "array"
        },
        "short_description": {
          "type": "string"
        },
        "signal_ports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowSignalPortDefinition"
          },
          "type": "array"
        }
      },
      "required": [
        "class_name",
        "short_description",
        "long_description",
        "kind",
        "handler_id",
        "interfaces",
        "activation_parameters",
        "parameters",
        "input_ports",
        "output_ports",
        "dynamic_input_ports",
        "dynamic_output_ports",
        "action_ports",
        "signal_ports"
      ],
      "type": "object"
    },
    "FlowNodeFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "failure": {
          "$ref": "#/$defs/Failure",
          "description": "What the node reported, as the host's `FailureDisclosure` lets the flow receive it."
        },
        "id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/FlowPortPhase"
        }
      },
      "required": [
        "id",
        "node_id",
        "phase",
        "operation",
        "code",
        "failure"
      ],
      "type": "object"
    },
    "FlowNodePortNames": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "automation": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "input": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "output": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "signal": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "FlowNodePortOrder": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "automation": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "input": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "output": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "signal": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "FlowNodePortParameterValues": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "object"
        },
        "output": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "FlowParameterDataType": {
      "additionalProperties": false,
      "description": "A nominal datatype registered by the host, or a recursive list/map of datatypes.",
      "properties": {
        "item_type": {
          "$ref": "#/$defs/FlowParameterDataType"
        },
        "kind": {
