        {
          "const": "not_dispatched",
          "description": "The executor or transport confirms the call was not dispatched.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "The executor returned a complete result, including a tool-reported execution error.",
          "type": "string"
        },
        {
          "const": "uncertain",
          "description": "The call may have run; cancellation and connection loss do not resolve its effects.",
          "type": "string"
        }
      ]
    },
    "ToolCode": {
      "description": "The refusals with which tool admission, the tool registry and the shared tool loop refuse\na request or a provider's tool call. Each serialises as its stable snake_case code.",
      "oneOf": [
        {
          "enum": [
            "invalid_tool_continuation",
            "tool_continuation_conflict",
            "tool_continuation_storage",
            "tool_continuation_unresolved",
            "tool_continuation_expired",
            "unsupported_tool_continuation"
          ],
          "type": "string"
        },
        {
          "const": "tool_approval_conflict",
          "description": "The durable approval journal or request revision changed.",
          "type": "string"
        },
        {
          "const": "tool_approval_storage",
          "description": "An approval storage operation requires inspection before continuing.",
          "type": "string"
        },
        {
          "const": "tool_approval_unresolved",
          "description": "A durable tool dispatch intent requires reconciliation.",
          "type": "string"
        },
        {
          "const": "invalid_tool_approval",
          "description": "The host supplied an invalid approval scope, capacity or journal.",
          "type": "string"
        },
        {
          "const": "tool_approval_denied",
          "description": "The host denied the validated tool call.",
          "type": "string"
        },
        {
          "const": "tool_approval_pending",
          "description": "The validated tool call requires a host decision before dispatch.",
          "type": "string"
        },
        {
          "const": "tool_approval_expired",
          "description": "The approval scope expired before dispatch.",
          "type": "string"
        },
        {
          "const": "tool_approval_capacity",
          "description": "The approval executor exhausted its call or payload capacity.",
          "type": "string"
        },
        {
          "const": "invalid_tool_rounds",
          "description": "A request's tool round limit is outside the supported range.",
          "type": "string"
        },
        {
          "const": "duplicate_tool",
          "description": "Two tools share a name, or a tool's name is blank, once names are normalised.",
          "type": "string"
        },
        {
          "const": "invalid_tool_schema",
          "description": "A tool's input schema is not a valid JSON Schema.",
          "type": "string"
        },
        {
          "const": "invalid_tool_definition",
          "description": "A tool's record cannot be offered: its name is outside the tool-name alphabet, it has\nno description, its input schema is not an object schema, or its profiles are not\ndistinct names.",
          "type": "string"
        },
        {
          "const": "unoffered_tool_choice",
          "description": "The request's tool choice names a tool the request does not offer.",
          "type": "string"
        },
        {
          "const": "malformed_tool_call",
          "description": "The provider returned a tool call without an id, name or object arguments.",
          "type": "string"
        },
        {
          "const": "tool_use_disabled",
          "description": "The provider requested tools although tool use was disabled.",
          "type": "string"
        },
        {
          "const": "invalid_tool_call_id",
          "description": "The provider returned a missing or duplicate tool call id.",
          "type": "string"
        },
        {
          "const": "unoffered_tool",
          "description": "The provider called a tool the model was not offered.",
          "type": "string"
        },
        {
          "const": "tool_outside_choice",
          "description": "The provider called a tool other than the one the tool choice names.",
          "type": "string"
        },
        {
          "const": "invalid_tool_arguments",
          "description": "A tool call's arguments do not satisfy the tool's input schema.",
          "type": "string"
        },
        {
          "const": "invalid_tool_result",
          "description": "A tool's result does not satisfy the output schema the tool declares.",
          "type": "string"
        },
        {
          "const": "unsupported_tool_content",
          "description": "The provider conversation cannot represent the tool's returned content.",
          "type": "string"
        },
        {
          "const": "unregistered_tool",
          "description": "The registry holds no tool with the called name.",
          "type": "string"
        },
        {
          "const": "tool_transcript_too_large",
          "description": "The tool calls and results of a run exceed their encoded-byte limit.",
          "type": "string"
        },
        {
          "const": "tool_rounds_exceeded",
          "description": "The provider was still calling tools after the request's last tool round.",
          "type": "string"
        }
      ]
    },
