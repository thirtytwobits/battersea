{
  "name": "battersea-typescript",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run test:editor && node scripts/check.mjs",
    "api:update": "npm run build && node scripts/check.mjs --update-api",
    "package:check": "npm run check && node scripts/package-check.mjs",
    "test:editor": "tsx --test tests/editor/*.test.ts tests/editor/*.test.tsx",
    "test:example": "node scripts/example-check.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^25.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0",
    "@types/d3-force": "^3.0.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirtytwobits/battersea.git",
    "directory": "typescript"
  }
}
