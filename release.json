{
  "version": "0.20.0",
  "repository": "https://github.com/thirtytwobits/battersea",
  "license": "MIT",
  "security_contact": "https://github.com/thirtytwobits/battersea/security/advisories/new",
  "consumer": "battersea-ops",
  "files": [
    "*.crate",
    "*.tgz",
    "battersea-docs-v*.tar.gz"
  ],
  "steps": {
    "prepare": [
      [
        "python3",
        "tools/release_steps.py",
        "npm-version",
        "{previous}",
        "{version}"
      ]
    ],
    "gates": [
      [
        "cargo",
        "xtask",
        "check"
      ],
      [
        "cargo",
        "xtask",
        "api"
      ],
      [
        "cargo",
        "xtask",
        "release-check"
      ],
      [
        "cargo",
        "xtask",
        "package"
      ],
      [
        "npm",
        "--prefix",
        "typescript",
        "run",
        "package:check"
      ]
    ]
  },
  "crates": {
    "battersea-flow": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "NOTICE",
      "LICENSE",
      "schemas/flow.schema.json",
      "fixtures/token-type-compatibility.json"
    ],
    "battersea-runtime": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "battersea-model": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "battersea-tools": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE",
      "schemas/tools.schema.json"
    ],
    "battersea-ops": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "battersea-providers": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "battersea-config": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE",
      "src/backend.schema.yaml"
    ],
    "battersea-nodes": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE",
      "src/nodes.yaml"
    ],
    "battersea-guard": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "battersea-pianola": [
      "Cargo.toml",
      "src/lib.rs",
      "schemas/pianola-roll.schema.json",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "battersea-telemetry": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE",
      "schemas/runtime.schema.json"
    ],
    "battersea-derive": [
      "Cargo.toml",
      "src/lib.rs",
      "README.md",
      "LICENSE",
      "NOTICE"
    ]
  },
  "npm": {
    "@battersea/flow": [
      "package.json",
      "dist/index.js",
      "dist/index.d.ts",
      "NOTICE",
      "README.md",
      "LICENSE",
      "schemas/flow.schema.json",
      "fixtures/token-type-compatibility.json",
      "fixtures/flows.json",
      "schemas/runtime.schema.json",
      "schemas/tools.schema.json",
      "schemas/operation.schema.json"
    ],
    "@battersea/editor": [
      "package.json",
      "dist/index.js",
      "dist/index.d.ts",
      "dist/graph.js",
      "README.md",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md"
    ]
  }
}
